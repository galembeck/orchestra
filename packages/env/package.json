{
  "name": "@orchestra/env",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "@t3-oss/env-nextjs": "0.13.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@orchestra/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
