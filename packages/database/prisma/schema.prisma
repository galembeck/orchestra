generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?
  termsAcceptedAt  DateTime  @map("terms_accepted_at")
  termsVersion     String    @map("terms_version")
  adultConfirmedAt DateTime  @map("adult_confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  sessions         Session[]
  accounts         Account[]
  owns_companies   Company[]
  member           Member?
  authoredInvites  Invite[]

  @@map("users")
}

enum CompanyRole {
  ADMIN
  BILLING
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  members  Member[]
  invites  Invite[]
  jobRoles CompanyJobRole[]

  @@map("companies")
}

model Member {
  id        String      @id @default(uuid())
  role      CompanyRole @default(MEMBER)
  createdAt DateTime    @default(now()) @map("created_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobRoles MemberJobRole[]

  @@map("members")
}

model Invite {
  id        String       @id @default(uuid())
  email     String
  role      CompanyRole  @default(MEMBER)
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id")
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([email, companyId])
  @@index([email])
  @@map("invites")
}

model JobRole {
  id   String @id @default(uuid())
  key  String @unique
  slug String @unique

  companies CompanyJobRole[]
  members   MemberJobRole[]

  @@map("job_roles")
}

model CompanyJobRole {
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobRoleId String  @map("job_role_id")
  jobRole   JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([companyId, jobRoleId])
  @@map("company_job_roles")
}

model MemberJobRole {
  memberId  String  @map("member_id")
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  jobRoleId String  @map("job_role_id")
  jobRole   JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([memberId, jobRoleId])
  @@map("member_job_roles")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}
