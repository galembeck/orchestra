{
  "name": "@orchestra/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/create-prisma-client.d.ts",
      "default": "./dist/create-prisma-client.js"
    },
    "./client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "default": "./dist/generated/prisma/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev": "tsc --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@orchestra/env": "workspace:*",
    "@orchestra/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@orchestra/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
