{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@orchestra/database": "workspace:*",
    "@orchestra/env": "workspace:*",
    "@orchestra/rbac": "workspace:*",
    "@orchestra/shared": "workspace:*",
    "better-auth": "1.7.17",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@orchestra/typescript-config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
