# Copy to .env at the repo root: `cp .env.example .env`
# Read by apps/api, packages/database (prisma.config.ts) and docker-compose.yml.

NODE_ENV=development

# PostgreSQL (matches docker-compose.yml; start it with `pnpm db:up`)
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra
POSTGRES_DB=orchestra
DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra

# API (Fastify)
API_HOST=0.0.0.0
API_PORT=3333
WEB_URL=http://localhost:3000

# Web (Next.js). Put overrides in apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3333
